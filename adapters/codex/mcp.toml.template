# steve-designer — MCP servers
#
# Merge into ~/.codex/config.toml (personal) or .codex/config.toml (project).
# Keep the server count <= 3 — every server injects tool definitions into context.
# Include the shadcn block only when the repository actually uses shadcn.

[mcp_servers.context7]
command = "npx"
args = ["-y", "@upstash/context7-mcp@latest"]

[mcp_servers.playwright]
command = "npx"
args = ["@playwright/mcp@latest"]

# Include only when the repo uses shadcn:
# [mcp_servers.shadcn]
# command = "npx"
# args = ["shadcn@latest", "mcp"]
