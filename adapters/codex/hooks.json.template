{
  "description": "steve-designer — in-session design-lint gate. Convenience only: the guarantee is the git-level gate (pre-commit + CI).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<STEVE_SKILL_DIR>/scripts/hook_design_lint.sh\"",
            "timeout": 30,
            "statusMessage": "steve-designer: design-lint"
          }
        ]
      }
    ]
  }
}
